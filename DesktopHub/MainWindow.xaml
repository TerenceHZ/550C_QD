<Window x:Class="DesktopHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="550C Archive"
        Icon="icon.ico"
        WindowStyle="None" AllowsTransparency="False" Background="#01000000"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        MinWidth="720" MinHeight="340"
        Width="1409" Height="938">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="Amber" Color="#E8B04A"/>
        <SolidColorBrush x:Key="AmberDim" Color="#8A6E3C"/>
        <SolidColorBrush x:Key="Ink" Color="#EFE0C0"/>
        <SolidColorBrush x:Key="Dim" Color="#9C8763"/>
        <FontFamily x:Key="Mono">Consolas</FontFamily>

        <Style x:Key="AmberScroll" TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#7AE8B04A" CornerRadius="2" Margin="1,2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PadButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AmberDim}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Amber}"/>
                    <Setter Property="Background" Value="#22E8B04A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="RootFrame" BorderBrush="#66E8B04A" BorderThickness="1" CornerRadius="2">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.72,1">
                <GradientStop Color="#F51A1610" Offset="0"/>
                <GradientStop Color="#F50E0C0A" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <!-- starfield -->
            <Canvas x:Name="StarCanvas" IsHitTestVisible="False" ClipToBounds="True"/>

            <!-- faint grid backdrop -->
            <Rectangle IsHitTestVisible="False" Opacity="0.55">
                <Rectangle.Fill>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,72,72" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="Transparent">
                                <GeometryDrawing.Pen>
                                    <Pen Brush="#14E8B04A" Thickness="1"/>
                                </GeometryDrawing.Pen>
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <LineGeometry StartPoint="0,0" EndPoint="72,0"/>
                                        <LineGeometry StartPoint="0,0" EndPoint="0,72"/>
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <!-- header strip -->
                <Border Grid.Row="0" Background="#14E8B04A" BorderBrush="#33E8B04A" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="Header_MouseDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="550C · ACCESS ARCHIVE"
                                   Foreground="{StaticResource Amber}"
                                   FontFamily="{StaticResource Mono}" FontSize="12"
                                   VerticalAlignment="Center" Margin="16,0,18,0"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                    HorizontalAlignment="Left" Margin="36,0,20,0">
                            <TextBlock Text="⌕" Foreground="#8A6E3C"
                                       FontFamily="{StaticResource Mono}" FontSize="21"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Border BorderBrush="#55E8B04A" BorderThickness="0,0,0,1" Width="300">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&gt;" Foreground="#8A6E3C"
                                               FontFamily="{StaticResource Mono}" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBox Grid.Column="1" x:Name="SearchBox" Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Amber}"
                                             FontFamily="{StaticResource Mono}" FontSize="12"
                                             Padding="0,4" VerticalContentAlignment="Center"
                                             TextChanged="SearchBox_TextChanged"/>
                                </Grid>
                            </Border>

                            <!-- category chips -->
                            <StackPanel x:Name="CategoryBar" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="22,0,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="LAUNCHPAD" Foreground="#8A6E3C" FontFamily="Bahnschrift" FontWeight="SemiBold"
                                       FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="▁" Style="{StaticResource PadButton}" FontSize="14"
                                    Click="BtnMin_Click" ToolTip="最小化"/>
                            <Button Content="✕" Style="{StaticResource PadButton}" FontSize="14"
                                    Click="BtnClose_Click" ToolTip="关闭（Esc）"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- icon grid -->
                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="IconScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="16,14,10,10"
                                  ScrollChanged="IconScroll_ScrollChanged">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource AmberScroll}"/>
                        </ScrollViewer.Resources>
                        <StackPanel x:Name="SectionsPanel"/>
                    </ScrollViewer>

                    <!-- scroll hint: fades in when there is more below -->
                    <Border x:Name="ScrollHint" VerticalAlignment="Bottom" Height="40"
                            IsHitTestVisible="False" Visibility="Collapsed">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#0006070A" Offset="0"/>
                                <GradientStop Color="#D906070A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="▼" Foreground="#AAE8B04A"
                                   FontFamily="{StaticResource Mono}" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                   Margin="0,0,0,8"/>
                    </Border>
                </Grid>

                <TextBlock x:Name="EmptyHint" Grid.Row="1"
                           Text="收纳区里还没有东西"
                           Foreground="{StaticResource Dim}"
                           FontFamily="{StaticResource Mono}" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>

                <!-- bottom status strip -->
                <Border Grid.Row="2" Background="#D9E8B04A">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock x:Name="CountText" Foreground="#1A1206"
                                       FontFamily="{StaticResource Mono}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="  ·  " Foreground="#661A1206"
                                       FontFamily="{StaticResource Mono}" FontSize="11"/>
                            <TextBlock x:Name="CategoryText" Text="ALL" Foreground="#1A1206"
                                       FontFamily="{StaticResource Mono}" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="ClockText" Text="--:--:--" Foreground="#1A1206"
                                       FontFamily="{StaticResource Mono}" FontSize="10" FontWeight="SemiBold"
                                       Margin="0,0,14,0"/>
                            <TextBlock Text="ACCESS GRANTED" Foreground="#1A1206"
                                       FontFamily="{StaticResource Mono}" FontSize="10" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
